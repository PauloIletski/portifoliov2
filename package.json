{
  "name": "portfoliov2",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:portfoliov2": "node dist/portfoliov2/server/server.mjs",
    "dev": "ng build --configuration development --localize --delete-output-path=false && concurrently --kill-others \"ng build --watch --configuration development --localize --delete-output-path=false\" \"python3 -m http.server 8080 --directory dist/portfoliov2/browser\"",
    "prebuild": "node scripts/configure-supabase.mjs",
    "prestart": "node scripts/configure-supabase.mjs",
    "predev:preview": "node scripts/configure-supabase.mjs",
    "supabase:config": "node scripts/configure-supabase.mjs"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/aria": "^21.2.14",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.26",
    "@supabase/supabase-js": "^2.117.3",
    "express": "^5.1.0",
    "motion": "^14.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/localize": "^21.2.25",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "concurrently": "^10.0.6",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "supabase": "^2.121.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}